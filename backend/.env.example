MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=dfip
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_PBKDF2_ROUNDS=310000
STORAGE_PATH=../storage
DEMO_MODE=true
ADMIN_PASSWORD=
REQUIRE_DESKTOP_FOR_WRITES=false
# "Create account" on the sign-in page: approval (admin activates new accounts), open, or disabled.
REGISTRATION_MODE=approval
CORS_ORIGINS=http://localhost:5173,http://localhost
MAX_UPLOAD_BYTES=53687091200
REQUIRE_HTTPS=false
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# Threat intel — leave blank to disable a provider. Lookups honestly report
# NOT_CONFIGURED rather than fabricating a verdict when a key is missing.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
