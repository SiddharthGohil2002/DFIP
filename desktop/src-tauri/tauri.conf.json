{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DFIP Investigator",
  "version": "2.1.0",
  "identifier": "org.dfip.investigator",
  "build": {
    "beforeDevCommand": { "script": "npm run dev:desktop", "cwd": "../frontend", "wait": false },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": { "script": "npm run build:desktop", "cwd": "../frontend" },
    "frontendDist": "../../frontend/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "DFIP Investigator",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "DFIP Investigator",
    "longDescription": "Desktop client for the DFIP Digital Forensics Investigation Platform."
  }
}
