# Production: use a long random JWT secret and disable demo mode.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=dfip
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_PBKDF2_ROUNDS=310000
STORAGE_PATH=./storage
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=53687091200
JOB_POLL_SECONDS=1
REQUIRE_HTTPS=false
MONGO_ROOT_USERNAME=dfiproot
MONGO_ROOT_PASSWORD=replace-with-a-strong-mongodb-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Threat intel — leave blank to disable a provider.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Optional public release URLs. Leave unset until signed artifacts are published.
DFIP_DOWNLOAD_WINDOWS_URL=
