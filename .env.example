# Used by docker-compose.yml. Copy to .env and replace every secret.
# Production: use a long random JWT secret, disable demo mode and set ADMIN_PASSWORD.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_PBKDF2_ROUNDS=310000
DEMO_MODE=true
# Initial admin@dfip.local password when DEMO_MODE=false (min 12 characters).
ADMIN_PASSWORD=
# true = only a registered DFIP desktop workstation may create/modify data.
REQUIRE_DESKTOP_FOR_WRITES=false
# "Create account" on the sign-in page: approval (admin activates new accounts), open, or disabled.
REGISTRATION_MODE=approval
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://tauri.localhost,tauri://localhost,http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=53687091200
MONGO_ROOT_USERNAME=dfiproot
MONGO_ROOT_PASSWORD=replace-with-a-strong-mongodb-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
# Full disk-image analysis job limit in seconds (default 6 hours).
ANALYSIS_TIME_LIMIT=21600

# Encrypts stored secrets (passwords and recovery keys of encrypted volumes, and the key of the self-signed report
# certificate). Empty: derived from JWT_SECRET.
# Changing it makes the stored keys unreadable; they are then entered again.
DATA_ENCRYPTION_KEY=

# Threat intel — leave blank to disable a provider.
VIRUSTOTAL_API_KEY=
# Automatic lookups of program hashes (turned on per case) are spaced to this rate; 4 a minute is the public API's limit.
# The address can point at a proxy or a private mirror.
VIRUSTOTAL_RATE_PER_MINUTE=4
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
ABUSEIPDB_API_KEY=
OTX_API_KEY=
# abuse.ch Auth-Key for URLhaus lookups (https://auth.abuse.ch/)
URLHAUS_API_KEY=

# Claude mode of the case assistant (Case summary page), off for every case until someone turns it on there.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional: send Anthropic API requests through a proxy.
ANTHROPIC_BASE_URL=

# Report signing. Without a certificate, report PDFs are signed with a self-signed one DFIP makes (shown as not trusted).
# Paths are inside the container: put the files in storage/signing/ and write them as /app/storage/signing/<file name>.
REPORT_SIGNING_P12=
REPORT_SIGNING_P12_PASSWORD=
# RFC 3161 timestamp authority: adds a trusted signing time to every report PDF.
REPORT_TSA_URL=
# PEM bundles of the root certificates verification trusts, for report signers and for timestamps.
REPORT_TRUST_ROOTS=
REPORT_TSA_TRUST_ROOTS=

# Memory images (Volatility 3). true = Volatility may download symbols from Microsoft's symbol server
# (it sends the kernel's PDB name and GUID); false = offline, using the symbol packs added in System & tools.
MEMORY_SYMBOL_SERVER=false
# The Windows symbol pack an administrator can download from System & tools.
MEMORY_SYMBOL_PACK_URL=https://downloads.volatilityfoundation.org/volatility3/symbols/windows.zip
# Time limit for each Volatility plugin, in seconds.
MEMORY_PLUGIN_TIMEOUT=7200
